{
  "name": "@outfit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8000",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "db:migrate:local": "wrangler d1 migrations apply outfit-db --local",
    "db:migrate": "wrangler d1 migrations apply outfit-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@outfit/engine": "*",
    "@outfit/shared": "*",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
